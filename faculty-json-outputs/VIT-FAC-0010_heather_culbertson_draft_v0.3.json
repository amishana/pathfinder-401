  "research": {
    "summary": "Current work develops natural and intuitive haptic hardware, rendering algorithms, and human-centered interaction methods for virtual reality, robotics, medicine, accessibility, and mediated social touch. The program integrates human perception throughout the design process and includes wearable and handheld feedback, multimodal and vibro-thermal rendering, personalized vibration feedback, disability-centered haptic experiences, and AI-enabled haptic authoring and modeling.",
    "domains": [
      "Haptic interfaces",
      "Multisensory XR",
      "Haptic texture rendering",
      "Mediated social touch",
      "Haptics and touch perception",
      "Human-robot interaction",
      "Virtual and extended reality",
      "Accessible interaction"
    ],
