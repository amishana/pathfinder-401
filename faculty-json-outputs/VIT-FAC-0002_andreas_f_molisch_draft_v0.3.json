  "research": {
    "summary": "Current work spans wireless propagation measurement and modeling for sub-terahertz, mm-wave, vehicular, UAV, massive-MIMO, and cell-free systems; machine learning for channel generation, prediction, and localization; ultrawideband and near-field localization; integrated sensing and communications; and joint communication, computing, and caching. Recent 2026 work emphasizes data-driven channel models, foundation models for indoor localization, vehicular ISAC synchronization, and reconfigurable-antenna localization.",
    "domains": [
      "Wireless propagation and channel modeling",
      "5G/6G systems",
      "Integrated sensing and communication",
      "Machine learning for wireless systems",
      "Wireless propagation channels",
      "Sub-THz and mm-wave systems",
      "Massive and cell-free MIMO",
      "Wireless localization and ISAC",
      "Edge communication and computing"
    ],
    "methods": [
      "Channel measurement and modeling",
      "MIMO and beamforming",
      "Ultrawideband localization",
      "Machine-learning-assisted wireless modeling",
      "Channel measurement and sounding",
      "Statistical channel modeling",
      "Machine learning and foundation models",
      "MIMO and reconfigurable-antenna design"
    ],
    "applications": [
      "Wireless networks",
      "Vehicular radar and sensing",
      "Localization",
      "Satellite-terrestrial coexistence",
      "5G/6G communications",
      "Indoor and vehicular localization",
      "Vehicle-to-vehicle and UAV links",
      "Mission-critical networks",
      "Wireless sensing"
    ],
