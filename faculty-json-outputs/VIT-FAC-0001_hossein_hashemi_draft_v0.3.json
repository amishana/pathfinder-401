  "research": {
    "summary": "Current work spans RF and millimeter-wave integrated circuits and systems, reconfigurable radios, phased arrays and beamforming, photonic integrated systems and optical phased arrays, low-power circuits, biomedical implants, internet-of-things devices, and wireless energy harvesting. The 2025-2026 publication record also shows active work in algorithmic and inverse design of nonintuitive RF/mm-wave networks, FMCW LiDAR, and ingestible sensing electronics.",
    "domains": [
      "RF/mm-wave integrated circuits",
      "Photonic integrated systems",
      "Neural-interface electronics",
      "Algorithmic and inverse RF design",
      "Biomedical and ingestible electronics"
    ],
    "methods": [
      "Integrated-circuit design",
      "Phased-array architecture",
      "Optical/RF co-integration",
