# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Supabase (required for search, load_db.py, scrape_profiles.py) ──────────────
# Use the transaction pooler string (port 6543) from the Supabase dashboard.
DATABASE_URL=postgresql://postgres.ovtaglhqnjzvbweendhj:<PASSWORD>@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# ── USC AI Gateway (required for structure_cv.py — PDF → JSON pipeline) ─────────
# Get your key from the ITS getting-started page.
USC_AI_GATEWAY_BASE_URL=https://aigateway-test.its.usc.edu/v1
USC_AI_GATEWAY_API_KEY=your-gateway-key-here
USC_AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# ── OpenAI (required for summarize.py — auto-fills missing research summaries) ──
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
